---
/**
 * BaseLayout.astro — HTML shell untuk semua halaman.
 *
 * Memuat:
 *  - IBM Plex Sans dari Google Fonts (preconnect untuk performa)
 *  - Global CSS
 *  - Header & Footer
 *  - Skip link untuk aksesibilitas
 *  - Astro prefetch untuk navigasi instan
 */
import '../styles/global.css';
import { SITE } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Fab from '../components/Fab.astro';
import SocialProof from '../components/SocialProof.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  schema?: object | object[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="id" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- IBM Plex Sans dari Google Fonts (preconnect + stylesheet load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- RSS feed discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Artikel terbaru`}
      href={new URL('/rss.xml', SITE.url).toString()}
    />

    <SEO {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <Header />
    <main id="main" class="main">
      <div class="container-wide">
        <slot />
      </div>
    </main>
    <Footer />
    <Fab />
    <SocialProof />
  </body>
</html>
