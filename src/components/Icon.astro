---
/**
 * Icon.astro — Komponen SVG inline berdasarkan Lucide Icons (https://lucide.dev)
 * Menggunakan SVG inline agar zero JS dependency & SEO-friendly.
 *
 * Props:
 *  - name: nama ikon Lucide (lihat daftar di bawah)
 *  - size: ukuran dalam px (default 20)
 *  - class: kelas tambahan
 *
 * Daftar ikon yang tersedia di sini:
 *  menu, list-video, x, arrow-right, arrow-left, arrow-up-right, mail, calendar,
 *  clock, chevron-right, chevron-down, rss, leaf, globe, file-text,
 *  shield, scroll-text, user, send, book-open,
 *  panda, square-equal, paw-print, headset,
 *  cart, code, search, server, check, phone, instagram, message-circle, star
 */

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

// Daftar path ikon Lucide (lisensi ISC, https://lucide.dev)
const icons: Record<string, string> = {
