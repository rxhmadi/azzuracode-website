---
/**
 * Reviews.astro — Horizontal scroll section untuk review/ulasan pelanggan.
 *
 * Layout:
 *   - Header dengan title "Apa kata pelanggan kami"
 *   - Horizontal scroll container dengan cards
 *   - Scroll-snap untuk pengalaman swipe yang halus
 *   - Avatar pakai initials berwarna (clean, tidak butuh stock photo)
 *   - Rating pakai icon star Lucide (5 bintang, filled sesuai rating)
 */
import { REVIEWS } from '../lib/site';
import Icon from './Icon.astro';
---

<section class="reviews-section">
  <div class="section-title">
    <h2>Apa kata pelanggan kami</h2>
    <span class="reviews-count">{REVIEWS.length} ulasan</span>
  </div>

  <div
    class="reviews-scroll"
    role="region"
    aria-label="Daftar ulasan pelanggan"
    tabindex="0"
  >
    {REVIEWS.map((review) => (
      <article class="review-card">
        <header class="review-card__header">
          <div
            class="review-card__avatar"
            style={`background-color: ${review.color}`}
            aria-hidden="true"
          >
            {review.initials}
          </div>
          <div class="review-card__identity">
            <div class="review-card__name">{review.name}</div>
            <div class="review-card__meta">
              {review.product} · {review.city}
            </div>
          </div>
        </header>

        <div
          class="review-card__rating"
          aria-label={`Rating: ${review.rating} dari 5 bintang`}
        >
          {Array.from({ length: 5 }, (_, i) => (
            <span class={`review-card__star ${i < review.rating ? 'is-filled' : 'is-empty'}`}>
              <Icon name="star" size={14} />
            </span>
          ))}
        </div>

        <p class="review-card__text">"{review.text}"</p>
      </article>
    ))}
  </div>

  <!-- Hint visual: indikator bisa di-scroll -->
  <div class="reviews-hint" aria-hidden="true">
    <span>Geser untuk lihat lebih banyak</span>
    <Icon name="chevron-right" size={14} />
  </div>
</section>

<style>
  .reviews-section {
    margin-top: var(--space-10);
  }

  .reviews-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .reviews-scroll {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 0 var(--space-4);
    margin: 0 -4px;       /* offset biar shadow card tidak kepotong */
    padding-inline: 4px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .reviews-scroll::-webkit-scrollbar {
    height: 6px;
  }
  .reviews-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .reviews-scroll::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border-radius: 3px;
  }
  .reviews-scroll:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
    border-radius: var(--radius);
  }

  .review-card {
    flex: 0 0 auto;
    width: 320px;
    scroll-snap-align: start;
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color 0.15s, transform 0.15s;
  }

  .review-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .review-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .review-card__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    flex-shrink: 0;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0;
    line-height: 1;
  }

  .review-card__identity {
    flex: 1;
    min-width: 0;
  }

  .review-card__name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .review-card__meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 2px;
    line-height: 1.3;
  }

  .review-card__rating {
    display: inline-flex;
    gap: 2px;
    color: var(--color-text-subtle);
  }

  .review-card__star.is-filled {
    color: #f59e0b;  /* amber untuk bintang terisi */
  }

  .review-card__star.is-empty {
    color: var(--color-border-strong);
  }

  .review-card__star :global(svg) {
    display: block;
  }

  .review-card__star.is-filled :global(svg) {
    fill: currentColor;
  }

  .review-card__text {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
  }

  .reviews-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    margin-top: var(--space-2);
  }

  /* Mobile: card lebih sempit, hint tetap terlihat */
  @media (max-width: 640px) {
    .review-card {
      width: 280px;
      padding: var(--space-4);
    }
  }

  /* Desktop: card sedikit lebih lebar */
  @media (min-width: 900px) {
    .review-card {
      width: 340px;
    }
  }

  /* Sembunyikan hint di desktop kalau semua card muat (tidak perlu scroll) */
  @media (min-width: 1200px) {
    .reviews-hint {
      display: none;
    }
  }
</style>
