  },
];
---

<div class="share-buttons" data-share-buttons>
  <span class="share-buttons__label">Bagikan artikel:</span>
  <div class="share-buttons__list">
    {sharePlatforms.map((platform) => (
      <a
        class="share-buttons__btn"
        href={platform.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Bagikan ke ${platform.name}`}
        title={`Bagarkan ke ${platform.name}`}
        data-share-platform={platform.name}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill={platform.color}
          aria-hidden="true"
          focusable="false"
        >
          <Fragment set:html={platform.svg} />
        </svg>
      </a>
    ))}

    <!-- Copy Link button — JS-based, tidak ada href -->
    <button
      class="share-buttons__btn share-buttons__btn--copy"
      type="button"
      aria-label="Salin link artikel"
      title="Salin link"
      data-copy-link={url}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .share-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }

  .share-buttons__label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .share-buttons__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .share-buttons__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
    transition: all 0.15s ease;
    cursor: pointer;
    padding: 0;
  }

  .share-buttons__btn:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
    transform: translateY(-1px);
  }

  .share-buttons__btn:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  .share-buttons__btn--copy[data-copied='true'] {
    background: var(--color-text);
    color: #fff;
    border-color: var(--color-text);
  }

  .share-buttons__btn svg {
    display: block;
  }
</style>

<script>
  // Copy link ke clipboard
  const copyBtns = document.querySelectorAll<HTMLElement>('[data-copy-link]');
  copyBtns.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-copy-link') || '';
      try {
        await navigator.clipboard.writeText(url);
        // visual feedback
        const originalTitle = btn.getAttribute('title') || '';
        btn.setAttribute('data-copied', 'true');
        btn.setAttribute('title', 'Tersalin!');
        // icon checkmark sementara
        const svg = btn.querySelector('svg');
        const originalSvg = svg ? svg.innerHTML : '';
        if (svg) {
          svg.innerHTML =
            '<polyline points="20 6 9 17 4 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
        }
        setTimeout(() => {
          btn.removeAttribute('data-copied');
          btn.setAttribute('title', originalTitle);
          if (svg) svg.innerHTML = originalSvg;
        }, 2000);
      } catch (err) {
        // fallback kalau clipboard API tidak support
        console.warn('Clipboard API tidak tersedia:', err);
      }
    });
  });
</script>
