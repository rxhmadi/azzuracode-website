---
/**
 * ShareButtons.astro — Tombol share artikel ke berbagai platform.
 *
 * Platforms: Facebook, WhatsApp, Threads, X (Twitter), LinkedIn,
 *            Telegram, TikTok, Copy Link.
 *
 * Style konsisten dengan web app: borderless icon-only buttons,
 * subtle hover background, compact.
 *
 * Catatan TikTok: TikTok tidak punya share intent URL untuk desktop.
 * Tombol akan redirect ke halaman upload TikTok (https://www.tiktok.com/upload).
 */
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

// Encode untuk URL share
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedCombined = encodeURIComponent(`${title} — ${url}`);

