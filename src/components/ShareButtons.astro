    href: `https://threads.net/intent/post?text=${encodedCombined}`,
    color: '#000000',
    svg: '<path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-1.465.404c-.56-2.052-1.535-3.605-2.928-4.628C16.56 2.19 14.635 1.6 12.19 1.58h-.012c-3.06.022-5.32 1.018-6.789 2.978C3.93 6.42 3.198 8.94 3.176 12c.022 3.06.755 5.58 2.213 7.44 1.47 1.963 3.73 2.96 6.789 2.98h.012c2.388-.022 4.075-.598 5.425-1.846 1.405-1.298 1.945-3.087 1.953-4.55 0-.366-.03-2.7-.03-2.7l-5.86 4.043c-.31.215-.697.327-1.074.327-.296 0-.587-.073-.84-.213-.46-.252-.74-.71-.74-1.207v-.282c0-.32.13-.624.357-.836l3.79-3.503h-3.85c-.93 0-1.69-.756-1.69-1.69 0-.934.76-1.69 1.69-1.69h6.865c.932 0 1.69.756 1.69 1.69 0 .433-.16.85-.46 1.157l-3.805 3.504h2.34c.94 0 1.7.755 1.7 1.69v.99c0 1.85-.684 4.225-2.5 5.905-1.55 1.43-3.66 2.16-6.43 2.18z"/>',
