---
/**
 * SEO.astro — Komponen meta tags lengkap untuk SEO mesin pencari & AI crawler.
 *
 * Mendukung:
 *  - Title, description, canonical
 *  - Open Graph (Facebook, LinkedIn, WhatsApp share)
 *  - Twitter Card
 *  - Robots meta (index/follow by default)
 *  - Article meta (published_time, modified_time, author, tags) untuk konten artikel
 *  - JSON-LD structured data (Schema.org) — dipahami Google & AI crawler
 *
 * Props:
 *  - title             : judul halaman (tanpa suffix brand, suffix ditambahkan otomatis)
 *  - description       : meta description (max ~155 char idealnya)
 *  - image             : URL absolut ke OG image (default ke /og-image.jpg)
 *  - canonical         : URL canonical (override otomatis dari Astro.url)
 *  - type              : 'website' | 'article' | 'profile' (default website)
 *  - noindex           : true untuk noindex (default false)
 *  - publishedTime     : ISO string (untuk article)
 *  - modifiedTime      : ISO string (untuk article)
 *  - author            : nama penulis (untuk article)
 *  - tags             : array of string (untuk article keywords)
 *  - schema            : object JSON-LD tambahan (Organization, Article, BreadcrumbList, dll)
 */

import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  schema?: object | object[];
}

const {
  title,
  description,
  image = '/og-image.jpg',
  canonical,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author = SITE.author,
  tags = [],
  schema,
} = Astro.props;

// bangun URL absolut untuk OG image
const ogImageUrl = new URL(image, Astro.site ?? 'https://stephanieknaturals.com').toString();
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();

// title dengan suffix brand, kecuali homepage
const fullTitle =
  Astro.url.pathname === '/' ? title : `${title} — ${SITE.name}`;

// robots meta
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

// default website schema kalau tidak diberikan
const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'id-ID',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/blog?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const schemaObjects = schema ?? defaultSchema;
const schemaArray = Array.isArray(schemaObjects) ? schemaObjects : [schemaObjects];
---

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robotsContent} />
<meta name="author" content={author} />
<meta name="generator" content={Astro.generator} />
<meta name="language" content="Indonesian" />
<meta http-equiv="content-language" content="id-ID" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="id_ID" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Article-specific OG -->
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && <meta property="article:author" content={author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={title} />

<!-- JSON-LD structured data -->
{schemaArray.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
