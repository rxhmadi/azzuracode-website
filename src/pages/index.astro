---
/**
 * Homepage — Hero + services + latest articles.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, TOPICS, SERVICES } from '../lib/site';
import { getPublishedArticles, formatDateID, readingTime } from '../lib/articles';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';

const articles = await getPublishedArticles();
const recentArticles = articles.slice(0, 4);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  founder: { '@type': 'Person', name: SITE.author },
  knowsAbout: TOPICS,
  sameAs: Object.values(SITE.social).filter(Boolean),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'id-ID',
  publisher: { '@type': 'Organization', name: SITE.name },
};

// Service schema untuk rich snippet
const serviceSchema = SERVICES.map((service) => ({
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: { '@type': 'Country', name: 'Indonesia' },
}));
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  type="website"
  schema={[organizationSchema, websiteSchema, ...serviceSchema]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__eyebrow">
      <Icon name="code" size={14} />
      <span>Jasa pembuatan website profesional</span>
    </div>
    <h1 class="hero__title">{SITE.tagline}</h1>
    <p class="hero__description">{SITE.description}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="/contact">
        <span>Konsultasi gratis</span>
        <Icon name="arrow-right" size={16} />
      </a>
      <a class="btn btn--ghost" href="#layanan">Lihat layanan</a>
    </div>
  </section>

  <!-- Layanan -->
  <section id="layanan" style="margin-top: var(--space-8);">
    <div class="section-title">
      <h2>Layanan kami</h2>
      <a href="/contact">Minta penawaran</a>
    </div>
    <div class="services-grid">
      {SERVICES.map((service) => (
        <article class="service-card">
          <div class="service-card__media">
            <img
              src={service.image}
              alt={service.name}
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
            <div class="service-card__overlay"></div>
          </div>
          <div class="service-card__content">
            <h3 class="service-card__title">{service.name}</h3>
            <p class="service-card__desc">{service.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Latest articles -->
  {recentArticles.length > 0 && (
    <section style="margin-top: var(--space-10);">
      <div class="section-title">
        <h2>Artikel terbaru</h2>
        <a href="/blog">Lihat semua</a>
      </div>
      <div class="article-list">
        {recentArticles.map((article) => {
          const minutes = readingTime(article.body);
          return (
            <a class="article-card" href={`/blog/${article.id}`}>
              <div class="article-card__meta">
                <Icon name="calendar" size={14} />
                <span>{formatDateID(article.data.pubDate)}</span>
                <span aria-hidden="true">·</span>
                <Icon name="clock" size={14} />
                <span>{minutes} menit baca</span>
              </div>
              <h3 class="article-card__title">{article.data.title}</h3>
              <p class="article-card__excerpt">{article.data.description}</p>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Reviews dari pelanggan -->
  <Reviews />

  <!-- CTA Section -->
  <section class="cta-section" style="margin-top: var(--space-10);">
    <div class="cta-card">
      <h2>Siap membangun website untuk bisnis Anda?</h2>
      <p>Konsultasi gratis — kami bantu identifikasi jenis website yang paling tepat untuk bisnis Anda, lengkap dengan estimasi biaya dan timeline yang transparan.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={SITE.whatsappLink} target="_blank" rel="noopener noreferrer">
          <Icon name="message-circle" size={16} />
          <span>Chat WhatsApp</span>
        </a>
        <a class="btn btn--ghost" href="/contact">Halaman kontak</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .services-grid {
    display: grid;
    /* Mobile: 2 columns (compact) */
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }
  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
  }
  @media (min-width: 900px) {
    .services-grid {
      /* Desktop: 4 columns (compact) */
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
    }
  }
  .service-card {
    position: relative;
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);  /* putih, menyatu dengan overlay */
  }

  /* Media area — image + overlay (no blur, no hover) */
  .service-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg);  /* putih fallback kalau image belum ada */
  }
  .service-card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* No blur — image tampil apa adanya */
  }

  /* White gradient fade overlay — dari transparent di atas ke putih solid di bawah */
  .service-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.2) 40%,
      rgba(255, 255, 255, 0.85) 80%,
      rgba(255, 255, 255, 1) 100%
    );
    pointer-events: none;
  }

  /* Content di atas overlay, di bagian bawah card */
  .service-card__content {
    position: relative;
    z-index: 1;
    padding: var(--space-3) var(--space-3) var(--space-4);
    /* Margin-top negatif supaya content overlap dengan media bagian bawah,
       seamless dengan overlay fade */
    margin-top: -32px;
  }
  .service-card__title {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--color-text);
    line-height: 1.3;
  }
  .service-card__desc {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0;
    /* Limit 3 baris supaya card height konsisten */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cta-card {
    padding: var(--space-8);
    background: var(--color-bg-subtle);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    text-align: center;
  }
  .cta-card h2 {
    margin-top: 0;
    margin-bottom: var(--space-3);
    font-size: clamp(1.25rem, 2vw + 0.5rem, 1.6rem);
  }
  .cta-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    max-width: 50ch;
    margin: 0 auto var(--space-5);
  }
  .cta-card .hero__cta {
    justify-content: center;
  }
</style>
